

# Groq AI Server Configuration
# GROQ_API_KEY: Server-side API key for Groq AI service calls.
GROQ_API_KEY=your_groq_api_key_here

# GROQ_MODEL: Model identifier for Groq AI calls (defaults to llama-3.3-70b-versatile if omitted).
GROQ_MODEL=llama-3.3-70b-versatile

# GROQ_BASE_URL: Optional OpenAI-compatible base URL for Groq (defaults to https://api.groq.com/openai/v1).
GROQ_BASE_URL=https://api.groq.com/openai/v1

# APP_URL: Hosted URL of the application.
APP_URL=http://localhost:3000

# Google Maps JavaScript API key (client-side, Vite)
VITE_GOOGLE_MAPS_API_KEY=

# Authentication Settings
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
JWT_SECRET=your_jwt_secret
